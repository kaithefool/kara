{
  "description": "Shift to Layer",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "left_shift",
        "modifiers": { "optional": ["any"] }
      },
      "to": [{ "key_code": "left_shift" }],
      "to_if_alone": [
        {
          "set_variable": {
            "name": "layer",
            "expression": "layer != 1 ? 1 : 0"
          }
        }
      ]
    }
  ]
}
