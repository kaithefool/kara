{
  "description": "Swap Caps_Lock with Esc & LCtrl",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "caps_lock",
        "modifiers": { "optional": ["any"] }
      },
      "to": [{ "key_code": "left_control" }],
      "to_if_alone": [{ "key_code": "escape" }]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "escape",
        "modifiers": { "optional": ["any"] }
      },
      "to": [{ "key_code": "caps_lock" }]
    }
  ]
}
