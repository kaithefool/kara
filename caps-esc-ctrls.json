{
  "description": "Swap Caps_Lock with Esc, LCtrl & Quote",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "escape",
        "modifiers": { "optional": ["any"] }
      },
      "to": [{ "key_code": "caps_lock" }]
    },

    {
      "type": "basic",
      "conditions": [
        {
          "type": "variable_unless",
          "name": "layer",
          "value": 1
        }
      ],
      "from": {
        "key_code": "caps_lock",
        "modifiers": { "optional": ["any"] }
      },
      "to": [{ "key_code": "left_control" }],
      "to_if_alone": [{ "key_code": "escape" }]
    },

    {
      "type": "basic",
      "conditions": [
        {
          "type": "variable_if",
          "name": "layer",
          "value": 1
        }
      ],
      "from": {
        "key_code": "caps_lock",
        "modifiers": { "optional": ["any"] }
      },
      "to": [{ "key_code": "left_control" }],
      "to_if_alone": [{ "key_code": "quote" }]
    }
  ]
}
